DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=growth_checkin
PORT=3001
NODE_ENV=development

# 微信小程序登录。上线前必须填写，并在微信公众平台配置 request 合法域名。
WX_APPID=
WX_SECRET=

# 本地模拟微信账号：
# 未配置 WX_APPID 时，只有来自 127.0.0.1 的开发者工具请求会自动使用模拟账号；
# 需要让局域网真机也登录时，可临时设为 true（生产环境永远不会启用）。
WX_LOGIN_MOCK=false
WX_MOCK_OPENID=mock-openid-growth-checkin

# 如果整站使用 HTTPS，可把会话 Cookie 设为 Secure
COOKIE_SECURE=false
